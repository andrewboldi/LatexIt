{
  "manifest_version": 2,
  "name": "LaTeX It!",
  "description": "Automatically change $\\LaTeX$ into images in your HTML mails.",
  "version": "0.8.16",
  "author": "Jonathan Protzenko",
  "homepage_url": "https://github.com/protz/LatexIt/wiki",
  "applications": {
    "gecko": {
      "id": "tblatex@andrewboldi.dev",
      "strict_min_version": "140.0",
      "strict_max_version": "999.*"
    }
  },
  "permissions": [
    "compose",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "menus",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "compose_scripts": [
    {
      "js": ["compose/compose-script.js"]
    }
  ],
  "compose_action": {
    "default_title": "LaTeX It!",
    "default_icon": "icon.png",
    "type": "menu"
  },
  "commands": {
    "tblatex-run-silent": {
      "description": "Run LaTeX It! silently in compose editor",
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      }
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "TBLatex": {
      "schema": "api/TBLatex/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "TBLatex"
          ]
        ],
        "script": "api/TBLatex/implementation.js"
      }
    }
  },
  "icons": {
    "32": "icon.png"
  }
}
